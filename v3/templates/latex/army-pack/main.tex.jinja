\documentclass[a4paper,12pt]{article}
\usepackage[margin=2cm]{geometry}
\usepackage[T1]{fontenc}
\usepackage{textcomp}
\usepackage{graphicx}
\usepackage{fancyhdr}
\usepackage{hyperref}

\hypersetup{
    colorlinks=true, %set true if you want colored links
    linktoc=all,     %set to all if you want both sections and subsections linked
    linkcolor=blue,  %choose some color if you want links to stand out
}



% A tiny version stamp in the footer of every page. `\maketitle` switches its
% own page to the `plain` style, so `plain` is redefined to match — otherwise
% the stamp is missing from exactly the page most people look at.
\newcommand{\versionfoot}{%
  \fancyhf{}%
  \fancyfoot[C]{\thepage}%  the page number the table of contents points at
  \fancyfoot[R]{\tiny v\VAR{spf_version}}%
  \renewcommand{\headrulewidth}{0pt}%
}
\pagestyle{fancy}
\versionfoot
\fancypagestyle{plain}{\versionfoot}

\title{\VAR{source.title | latex_escape}}

\begin{document}
\maketitle
\tableofcontents
\newpage

\BLOCK{for entry in source.entries}
\section{\VAR{entry.label | latex_escape}}

\BLOCK{set reference = entry.reference}
\BLOCK{set unit_heading = "\\subsection"}
\BLOCK{set model_heading = "\\subsubsection"}
\BLOCK{set equip_heading = "\\paragraph"}
\BLOCK{include "army-rules/reference-body.tex.jinja"}
\clearpage
\BLOCK{endfor}
\end{document}
