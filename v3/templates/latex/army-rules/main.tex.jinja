% A tiny version stamp in the footer of every page. `\maketitle` switches its
% own page to the `plain` style, so `plain` is redefined to match — otherwise
% the stamp is missing from exactly the page most people look at.
\newcommand{\versionfoot}{%
  \fancyhf{}%
  \fancyfoot[C]{\thepage}%  the page number the table of contents points at
  \fancyfoot[R]{\tiny v\VAR{spf_version}}%
  \renewcommand{\headrulewidth}{0pt}%
}
\pagestyle{fancy}
\versionfoot
\fancypagestyle{plain}{\versionfoot}

\title{\VAR{source.nick | latex_escape}}
\author{\VAR{source.race | latex_escape} --- \VAR{source.points} points}

\begin{document}
\maketitle

\BLOCK{if source.race_image}
\begin{center}
\includegraphics[width=0.5\textwidth]{\VAR{source.race_image | posix_path}}
\end{center}
\newpage
\BLOCK{endif}

