{#
  The shared body of an Army's rules: one heading block per distinct Unit,
  models nested below. Both the Army Reference and the Army Pack render an
  Army's rules through this one partial, so the two can never drift apart.

  `reference` is the `ArmyReference` to render, and `hashes` is the heading
  string a Unit sits at — `army-rules/main` sets it to `"##"` for a standalone
  document; `army-pack/main` sets it one level deeper, `"###"`, since each
  Army already sits under its own `##` heading in the Pack. Models and
  Equipment nest one and two levels below a Unit respectively, same as
  `general-rules/rules-body.md.jinja`'s `hashes` convention.
#}
{%- for unit in reference.units %}
{{ hashes }} {{ unit.name }}{% if unit.count > 1 %} ({{ unit.count }}×){% endif %}
{% if unit.image %}
![{{ unit.name }}]({{ unit.image | relative_to(output_dir) }})
{% endif %}
- Size: {{ unit.size }}
- Models: {{ unit.model_summary | join(', ') }}
{%- if unit.types %}
- Type: {{ unit.types | join(', ') }}
{%- endif %}
{%- if unit.armor %}
- Armor: {{ unit.armor | join('/') }}
{%- endif %}
- Points: {{ unit.points }}
- Shaken: {{ unit.shaken_speed }} [{{ unit.shaken_movement | join(', ') }}] / {{ unit.shaken_fire }}
{% for name, text in unit.specials %}
- **{{ name }}**{% if text %}: {{ text }}{% endif %}
{%- endfor %}
{% for name, rows, notes in unit.damage_tables %}
**Damage Table: {{ name }}**

| Roll | Effect |
| ---- | ------ |
{% for roll, effect in rows -%}
| {{ roll }} | {{ effect }} |
{% endfor -%}
{% for note in notes -%}
- {{ note }}
{% endfor -%}
{% endfor %}
{% for model in unit.models %}
{{ hashes }}# {{ model.name }}

- Equipment: {{ model.equipment_summary | join(', ') }}
- Assault: strength {{ model.assault_strength | join('/') }} ({{ model.assault_strength_die }}), deflection {{ model.assault_deflection | join('/') }} ({{ model.assault_deflection_die }}), damage {{ model.assault_damage }}, AP {{ model.assault_ap }}
{% for name, text in model.specials %}
- **{{ name }}**{% if text %}: {{ text }}{% endif %}
{%- endfor %}
{% for name, text in model.assault_specials %}
- **{{ name }}**{% if text %}: {{ text }}{% endif %}
{%- endfor %}
{% for equip in model.equipment %}
{{ hashes }}## {{ equip.name }}

- Range: {{ equip.range }}, angle {{ equip.angle | join('/') }}, damage {{ equip.damage }}, AP {{ equip.ap }}
{%- for name, text in equip.specials %}
- **{{ name }}**{% if text %}: {{ text }}{% endif %}
{%- endfor %}
{% endfor %}
{% endfor %}
---
{% endfor %}
