default: check

# Run all quality gates in order, stopping on the first failure.
check: fmt-check lint spell validate lint-races lint-rules lint-latex test typecheck

# Cut a release: bump the CalVer version, re-lock, commit, tag, and push.
release *args:
    cd .. && uv run --project v3 bumpver update --patch {{args}}

# Auto-format the codebase with ruff.
fmt:
    uv run ruff format -q

# Check formatting without writing changes.
fmt-check:
    uv run ruff format --check -q

# Lint the codebase with ruff.
lint:
    uv run ruff check -q

# Type-check src/ and tests/ with pyright.
typecheck:
    uv run pyright

# Spell-check the codebase with typos.
spell:
    uv run typos

# Fix spelling errors with typos.
spell-fix:
    uv run typos --write-changes

# Run the test suite quietly.
test *args:
    uv run pytest -q {{args}}

# Auto-fix lint issues then reformat.
fix:
    uv run ruff check --fix -q
    uv run ruff format -q

# Validate all toml files
validate:
    uv run spf race show abomination > /dev/null
    uv run spf race show darkelf > /dev/null
    uv run spf race show dwarf > /dev/null
    uv run spf race show elf > /dev/null
    uv run spf race show gnome > /dev/null
    uv run spf race show goblin > /dev/null
    uv run spf race show ork > /dev/null
    uv run spf race show ogre > /dev/null
    uv run spf rules hexes > /dev/null
    uv run spf rules specials > /dev/null
    uv run spf rules tokens > /dev/null
    uv run spf rules terrain > /dev/null
    uv run spf rules modifiers > /dev/null
    uv run spf rules namespaces > /dev/null
    uv run spf rules rulebook > /dev/null
    uv run spf assets profiles > /dev/null

# Lint race data for name and key consistency.
lint-races:
    uv run spf race lint

# Lint the rule registries for name and key consistency.
lint-rules:
    uv run spf rules lint

# Check that every LaTeX package used by a template is in the manifest.
lint-latex:
    uv run spf render lint

# Build every published Product/Format into output/, plus the Landing Page.
render-site:
    uv run spf render site
