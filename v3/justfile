default: check

# Run all quality gates in order, stopping on the first failure.
check: fmt-check lint spell lint-data test typecheck

# Cut a release: bump the CalVer version, re-lock, commit, tag, and push.
release *args:
    cd .. && uv run --project v3 bumpver update --patch {{args}}

# Auto-format the codebase with ruff.
fmt:
    uv run ruff format -q

# Check formatting without writing changes.
fmt-check:
    uv run ruff format --check -q

# Lint the codebase with ruff.
lint:
    uv run ruff check -q

# Type-check src/ and tests/ with pyright.
typecheck:
    uv run pyright

# Spell-check the codebase with typos.
spell:
    uv run typos

# Fix spelling errors with typos.
spell-fix:
    uv run typos --write-changes

# Run the test suite quietly.
test *args:
    uv run pytest -q {{args}}

# Deliberately not part of `just check`: see docs/agents/testing.md.
# Mutate lint-clean game-data values and report the tests that break.
test-friction *args:
    uv run python scripts/test_friction.py {{args}}

# Snapshot every rendered document into the gitignored goldens/.
golden-snapshot:
    uv run python scripts/goldens.py snapshot

# Re-render every document and diff it against the last snapshot.
golden-diff:
    uv run python scripts/goldens.py diff

# Auto-fix lint issues then reformat.
fix:
    uv run ruff check --fix -q
    uv run ruff format -q

# Lint every corpus: load failures, illegal Army builds, and style findings.
lint-data:
    uv run spf lint all

# Build every published Product/Format into output/, plus the Landing Page.
render-site:
    uv run spf render site
